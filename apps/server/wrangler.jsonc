{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "newsnow-server-dev",
  "main": "./src/adapters/cloudflare/entry.ts",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "dev": {
    "port": 6464,
    "inspector_port": 19230,
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": false,
    },
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "newsnow-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../libs/db/migrations/sqlite-d1",
      "migrations_pattern": "../../libs/db/migrations/sqlite-d1/*/migration.sql",
    },
  ],
}
