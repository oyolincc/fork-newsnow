{
  "name": "@newsnow/stack",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm dev:node",
    "build": "pnpm build:node",
    "preview": "pnpm preview:node",
    "dev:node-chain": "turbo watch dev:node --filter=@newsnow/stack",
    "dev:node": "DEPLOY_TARGET=node SERVER_BASE_PATH=/api oyo env server -- vp dev",
    "build:node-chain": "turbo build:node --filter=@newsnow/stack",
    "build:node": "DEPLOY_TARGET=node SERVER_BASE_PATH=/api oyo env server -- vp build",
    "preview:node": "DEPLOY_TARGET=node SERVER_BASE_PATH=/api oyo env server -- vp preview",
    "dev:cloudflare-chain": "turbo watch dev:cloudflare --filter=@newsnow/stack",
    "dev:cloudflare": "DEPLOY_TARGET=cloudflare vp dev",
    "build:cloudflare-chain": "turbo build:cloudflare --filter=@newsnow/stack",
    "build:cloudflare": "DEPLOY_TARGET=cloudflare vp build",
    "preview:cloudflare": "DEPLOY_TARGET=cloudflare vp preview",
    "deploy:cloudflare": "pnpm build:cloudflare-chain && wrangler deploy",
    "db:migrate:cloudflare:local": "wrangler d1 migrations apply DB --local --config wrangler.jsonc --persist-to ../../.wrangler/state",
    "cf:typegen": "wrangler types",
    "cf:typecheck": "wrangler types --check",
    "generate-routes": "tsr generate",
    "test": "vp test",
    "check": "pnpm codegen && vp check",
    "codegen": "panda codegen"
  },
  "dependencies": {
    "@newsnow/definition": "workspace:*",
    "@newsnow/server": "workspace:*",
    "@newsnow/ui": "workspace:*",
    "@tanstack/react-query": "catalog:frontend",
    "@tanstack/react-router": "catalog:frontend",
    "@tanstack/react-start": "catalog:frontend",
    "jotai": "catalog:frontend",
    "ky": "catalog:shared",
    "nitro": "catalog:",
    "react": "catalog:frontend",
    "react-dom": "catalog:frontend"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@oyolincc/cli": "catalog:",
    "@oyolincc/dev-config": "catalog:",
    "@pandacss/dev": "catalog:frontend",
    "@pandacss/preset-base": "catalog:frontend",
    "@pandacss/preset-panda": "catalog:frontend",
    "@pandacss/vite": "catalog:frontend",
    "@rollup/pluginutils": "catalog:",
    "@tanstack/react-query-devtools": "catalog:frontend",
    "@tanstack/react-router-devtools": "catalog:frontend",
    "@tanstack/router-cli": "catalog:frontend",
    "@types/node": "catalog:",
    "@types/react": "catalog:frontend",
    "@types/react-dom": "catalog:frontend",
    "@vitejs/plugin-react": "catalog:",
    "fast-glob": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "catalog:"
  }
}
