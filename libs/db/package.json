{
  "name": "@newsnow/db",
  "version": "0.0.0",
  "private": true,
  "description": "@newsnow/db",
  "homepage": "https://github.com/oyolincc/fork-newsnow.git#readme",
  "bugs": {
    "url": "https://github.com/oyolincc/fork-newsnow.git/issues"
  },
  "license": "MIT",
  "author": "oyolincc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oyolincc/fork-newsnow.git.git",
    "directory": "libs/db"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./schema": {
      "types": "./dist/schema.d.mts",
      "import": "./dist/schema.mjs",
      "default": "./dist/schema.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build",
    "export": "oyo env db-dev -- drizzle-kit export",
    "dev:push": "oyo env db-dev -- drizzle-kit push",
    "dev:gen": "oyo env db-dev -- drizzle-kit generate",
    "dev:migrate": "oyo env db-dev -- drizzle-kit migrate"
  },
  "dependencies": {
    "@newsnow/definition": "workspace:*",
    "better-sqlite3": "catalog:",
    "drizzle-orm": "catalog:drizzle"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@oyolincc/dev-config": "catalog:",
    "@types/better-sqlite3": "catalog:",
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:drizzle",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
