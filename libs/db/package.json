{
  "name": "@newsnow/db",
  "version": "0.0.0",
  "private": true,
  "description": "@newsnow/db",
  "homepage": "https://github.com/oyolincc/fork-newsnow.git#readme",
  "bugs": {
    "url": "https://github.com/oyolincc/fork-newsnow.git/issues"
  },
  "license": "MIT",
  "author": "oyolincc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oyolincc/fork-newsnow.git.git",
    "directory": "libs/db"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./sqlite/schema": "./dist/sqlite/schema.mjs",
    "./sqlite/sqlite": "./dist/sqlite/sqlite.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "sqlite:export": "oyo env sqlite -- drizzle-kit export --config=drizzle-kit/sqlite.config.ts",
    "dev:sqlite:push": "oyo env sqlite -- drizzle-kit push --config=drizzle-kit/sqlite.config.ts",
    "dev:sqlite:gen": "oyo env sqlite -- drizzle-kit generate --config=drizzle-kit/sqlite.config.ts",
    "dev:sqlite:migrate": "oyo env sqlite -- drizzle-kit migrate --config=drizzle-kit/sqlite.config.ts"
  },
  "dependencies": {
    "@newsnow/definition": "workspace:*",
    "better-sqlite3": "catalog:drizzle",
    "drizzle-orm": "catalog:drizzle"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:drizzle",
    "@oyolincc/cli": "catalog:",
    "@oyolincc/dev-config": "catalog:",
    "@types/better-sqlite3": "catalog:drizzle",
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:drizzle",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  }
}
