{
  "$schema": "https://turbo.build/schema.json",
  "futureFlags": {
    "watchUsingTaskInputs": true
  },
  "tasks": {
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "dev:node": {
      "dependsOn": ["^build"],
      "env": ["DEPLOY_TARGET"],
      "cache": false,
      "persistent": true
    },
    "dev:cloudflare": {
      "dependsOn": ["^build"],
      "env": ["DEPLOY_TARGET"],
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "outputs": ["dist/**", ".output/**"]
    },
    "build:dev": {
      "dependsOn": ["^build:dev", "build"],
      "inputs": ["package.json"]
    },
    "build:node": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "env": ["DEPLOY_TARGET"],
      "outputs": ["dist/**", ".output/**"]
    },
    "build:cloudflare": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.md"],
      "env": ["DEPLOY_TARGET"],
      "outputs": ["dist/**", ".output/**"]
    }
  }
}
