{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "dev:node": {
      "dependsOn": ["^build"],
      "env": ["DEPLOY_TARGET"],
      "cache": false,
      "persistent": true
    },
    "dev:cloudflare": {
      "dependsOn": ["^build"],
      "env": ["DEPLOY_TARGET"],
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**"]
    },
    "build:node": {
      "dependsOn": ["^build"],
      "env": ["DEPLOY_TARGET"],
      "outputs": ["dist/**", ".output/**"]
    },
    "build:cloudflare": {
      "dependsOn": ["^build"],
      "env": ["DEPLOY_TARGET"],
      "outputs": ["dist/**", ".output/**"]
    }
  }
}
